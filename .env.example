# Never place real credentials in this example or commit your local .env.
VIDEO_SOURCE=rtsp://encoded-email:password@camera-host:8554/stream/cam01

# Optional: send annotated preview and counts from this edge client to Render.
DASHBOARD_URL=https://your-service.onrender.com
DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Set the same secret as TELEMETRY_TOKEN in Render's Environment settings.
# Do not set RUN_LOCAL_INFERENCE on the free Render dashboard; inference runs here.
